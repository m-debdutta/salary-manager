// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Combobox > snapshot > matches closed snapshot 1`] = `
<DocumentFragment>
  <div
    class="combobox"
  >
    <button
      aria-expanded="false"
      aria-haspopup="listbox"
      class="form-input combobox__trigger"
      type="button"
    >
      <span
        class="combobox__placeholder"
      >
        Select…
      </span>
      <span
        aria-hidden="true"
        class="combobox__chevron"
      >
        ▾
      </span>
    </button>
  </div>
</DocumentFragment>
`;

